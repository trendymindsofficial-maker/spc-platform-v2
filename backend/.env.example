# ============================================================
# SBC Backend — environment template
# Copy to backend/.env for local development.
# On Render, add these under Service -> Environment.
# ============================================================

NODE_ENV=development

# Render injects PORT automatically. 8080 is the local default.
PORT=8080

# Comma-separated list of allowed frontend origins (CORS).
# Any https://*.vercel.app preview URL is also allowed automatically.
FRONTEND_ORIGIN=http://localhost:3000,https://www.studentbenefitcard.com

# ---- Firebase Admin ----
# Service account from Firebase Console -> Project Settings -> Service accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Base64-encoded PEM private key (portable across hosts that mangle newlines).
# Generate with:
#   node -e "console.log(Buffer.from(require('./service-account.json').private_key).toString('base64'))"
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=

# ============================================================
# RAZORPAY — PAYMENT BUTTON FLOW
# ============================================================
#
# Payments are collected by the hosted Razorpay Payment Button and
# captured server-side by the webhook at POST /api/payment/webhook.
# No Orders API approval is required.
# ------------------------------------------------------------

# Payment Button id from the embed snippet (data-payment_button_id).
# Test-mode and live-mode buttons are different ids.
RAZORPAY_PAYMENT_BUTTON_ID=

# Webhook secret — REQUIRED. Without it no payment can be captured.
# A value you choose yourself, NOT your API key secret.
#   Dashboard -> Settings -> Webhooks -> Add New Webhook
#     URL          : https://<service>.onrender.com/api/payment/webhook
#     Active events: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# ---- Razorpay Orders API (OPTIONAL) ----
# Only required to re-enable the legacy card checkout endpoints.
# Leave blank if your account is not approved for the Orders API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Push notification links ----
# Public site URL used for notification click-through and icon URLs.
APP_PUBLIC_URL=https://www.studentbenefitcard.com
NOTIFICATION_ICON_URL=https://www.studentbenefitcard.com/sbc-notification-icon.png
