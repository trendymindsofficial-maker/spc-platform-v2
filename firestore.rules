rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStudent(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isBusiness(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================
    // ADMINS
    // =========================
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    // =========================
    // STUDENTS
    // =========================
    match /students/{studentId} {

      // Registration creates the student's own profile.
      // Payment verification is performed server-side before the
      // registration page writes the profile.
      allow create: if isStudent(studentId);

      // Student/Admin can read.
      allow read: if isStudent(studentId) || isAdmin();

      // Student can update normal profile fields, but MUST NOT
      // change payment/membership authority fields from the browser.
      allow update: if isAdmin()
        || (
          isStudent(studentId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "mobile",
            "email",
            "college",
            "course",
            "year",
            "photoURL",
            "profileImage",
            "profileImageUrl",
            "updatedAt",
            "notificationsEnabled"
          ])
        )
        || (
          signedIn() &&
          isBusiness(request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "points",
            "totalPointsEarned",
            "lastPointsEarned",
            "lastPointsEarnedAt",
            "lastPointsBusinessId",
            "lastPointsBusinessName",
            "lastPointsRedemptionId",
            "updatedAt"
          ]) &&
          request.resource.data.lastPointsBusinessId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // =========================
    // BUSINESSES
    // =========================
    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.businessId == request.auth.uid;
      allow update: if isBusiness(businessId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================
    // CATEGORIES
    // =========================
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // OFFERS
    // =========================
    match /offers/{offerId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid;

      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow delete: if isAdmin() ||
        (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );
    }

    // =========================
    // BUSINESS STUDENT USAGE
    // =========================
    match /businessStudentUsage/{usageId} {

      allow read: if isAdmin()
        || (
          signedIn() &&
          usageId.split("_")[0] == request.auth.uid
        )
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        );

      allow create, update: if isAdmin()
        || (
          signedIn() &&
          request.resource.data.businessId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // =========================
    // STUDENT POINTS
    // =========================
    match /studentPoints/{studentId} {
      allow read: if isAdmin() || isStudent(studentId);

      allow create, update: if isAdmin()
        || (
          signedIn() &&
          request.resource.data.studentId == studentId &&
          request.resource.data.lastPointsBusinessId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // =========================
    // REDEMPTION REQUESTS
    // =========================
    match /redemptionRequests/{requestId} {

      /*
       * IMPORTANT:
       * Redemption requests are now created ONLY by the
       * authenticated server API (/api/redemption/create).
       * Firebase Admin SDK bypasses Firestore client rules.
       *
       * This prevents an expired student from bypassing the
       * membership check by writing directly to Firestore.
       */
      allow create: if false;

      allow read: if isAdmin()
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        )
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      // Business can change ONLY the approval status.
      // Student/business identity and offer details cannot be
      // changed by the business client.
      allow update: if isAdmin()
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "updatedAt",
            "rejectedAt",
            "approvedAt",
            "rejectionReason"
          ]) &&
          (
            request.resource.data.status == "approved" ||
            request.resource.data.status == "rejected" ||
            request.resource.data.status == "pending"
          )
        );

      allow delete: if isAdmin();
    }

    // =========================
    // REDEMPTIONS
    // =========================
    match /redemptions/{redeemId} {

      // Business creates redemption after approving a request.
      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        )
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // =========================
    // BLOCK EVERYTHING ELSE
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
