rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStudent(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isBusiness(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================
    // ADMINS
    // =========================
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    // =========================
    // STUDENTS
    // =========================
    match /students/{studentId} {
      allow create: if signedIn();

      // Student/admin can read normally.
      allow read: if isStudent(studentId) || isAdmin();

      // Student/admin can update normally.
      // A business may update ONLY the reward fields as part of
      // an approved redemption transaction. The redemption itself
      // must be created in the same atomic transaction.
      allow update: if isAdmin()
        || isStudent(studentId)
        || (
          signedIn() &&
          request.resource.data.lastPointsBusinessId == request.auth.uid &&
          request.resource.data.lastPointsRedemptionId != null &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.studentId == studentId &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.businessId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "points",
            "totalPointsEarned",
            "lastPointsEarned",
            "lastPointsEarnedAt",
            "lastPointsBusinessId",
            "lastPointsBusinessName",
            "lastPointsRedemptionId",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    // =========================
    // BUSINESSES
    // =========================
    match /businesses/{businessId} {
      // Needed for SBC Business ID / QR verification.
      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if isBusiness(businessId) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================
    // CATEGORIES
    // =========================
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================
    // OFFERS
    // =========================
    match /offers/{offerId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );
    }

    // =========================
    // BUSINESS STUDENT USAGE
    // =========================
    match /businessStudentUsage/{usageId} {

      // usageId format:
      // {businessAuthUid}_{studentId}
      //
      // Business can read only its own usage documents.
      allow read: if isAdmin()
        || (
          signedIn() &&
          usageId.matches('^' + request.auth.uid + '_.*$')
        )
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn() &&
          request.resource.data.businessId == request.auth.uid &&
          usageId.matches('^' + request.auth.uid + '_.*$')
        );

      allow update: if isAdmin()
        || (
          signedIn() &&
          request.resource.data.businessId == request.auth.uid &&
          usageId.matches('^' + request.auth.uid + '_.*$')
        );

      allow delete: if isAdmin();
    }

    // =========================
    // STUDENT POINTS
    // =========================
    match /studentPoints/{studentId} {
      // Only the student/admin can read cumulative points.
      // Business approval does NOT need to read this document.
      allow read: if isAdmin() || isStudent(studentId);

      allow create: if isAdmin()
        || isStudent(studentId)
        || (
          signedIn() &&
          request.resource.data.studentId == studentId &&
          request.resource.data.lastPointsBusinessId == request.auth.uid &&
          request.resource.data.lastPointsRedemptionId != null &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.studentId == studentId &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.businessId == request.auth.uid
        );

      allow update: if isAdmin()
        || isStudent(studentId)
        || (
          signedIn() &&
          request.resource.data.studentId == studentId &&
          request.resource.data.lastPointsBusinessId == request.auth.uid &&
          request.resource.data.lastPointsRedemptionId != null &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.studentId == studentId &&
          getAfter(
            /databases/$(database)/documents/redemptions/$(request.resource.data.lastPointsRedemptionId)
          ).data.businessId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentId",
            "totalPoints",
            "pointsAwarded",
            "lastPointsEarned",
            "lastPointsBusinessId",
            "lastPointsBusinessName",
            "lastPointsRedemptionId",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    // =========================
    // REDEMPTION REQUESTS
    // =========================
    match /redemptionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        )
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // =========================
    // REDEMPTIONS
    // =========================
    match /redemptions/{redeemId} {
      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.requestId != null
        && getAfter(
          /databases/$(database)/documents/redemptionRequests/$(request.resource.data.requestId)
        ).data.businessId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/redemptionRequests/$(request.resource.data.requestId)
        ).data.status == "approved"
        && request.resource.data.studentId ==
          getAfter(
            /databases/$(database)/documents/redemptionRequests/$(request.resource.data.requestId)
          ).data.studentId;

      allow read: if isAdmin()
        || (
          signedIn() &&
          resource.data.studentId == request.auth.uid
        )
        || (
          signedIn() &&
          resource.data.businessId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // =========================
    // BLOCK EVERYTHING ELSE
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
