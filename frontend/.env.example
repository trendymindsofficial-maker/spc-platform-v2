# ============================================================
# SBC Frontend — environment template
# Copy to .env.local for local development.
# On Vercel, add these under Project Settings -> Environment Variables.
# ============================================================

# ---- SBC Backend (Express service on Render) ----
# Local:      http://localhost:8080
# Production: https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_BASE_URL=

# ---- Firebase Web SDK (public by design) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Web Push (FCM) ----
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Razorpay hosted Payment Button ----
# The data-payment_button_id from the embed snippet.
# Optional: falls back to GET /api/payment/config when blank.
NEXT_PUBLIC_RAZORPAY_PAYMENT_BUTTON_ID=

# ---- Local-only: instant OTP for testing ----
# "true" skips the reCAPTCHA round trip, but then ONLY phone numbers
# registered under Firebase > Authentication > Phone numbers for testing
# will work, and no real SMS is sent. Ignored outside development.
# Must stay false/blank in production.
NEXT_PUBLIC_AUTH_DISABLE_RECAPTCHA=false
